# Copia este archivo como .env y llena los valores.
# NUNCA subas el .env a GitHub — ya está en .gitignore.

# --- Base de datos ---
# Dashboard de Vercel -> Storage -> tu base de datos -> pestaña ".env.local" -> copia POSTGRES_URL
POSTGRES_URL=

# --- Proveedor de IA ---
# gemini | claude | deepseek — el que pongas aquí es el de respaldo si el
# frontend no manda uno explícito. Puedes tener las 3 claves configuradas
# a la vez y elegir en la app cuál usar en cada sesión.
PROVIDER=gemini

# Google AI Studio -> https://aistudio.google.com/apikey  (empieza con AIzaSy...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# https://platform.deepseek.com/api_keys  (empieza con sk-...)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Autenticación ---
# Sin estas tres, la API rechaza todo (falla cerrada, nunca abierta).
AUTH_USERNAME=

# NUNCA la contraseña en texto plano: solo su hash.
# Genera el tuyo con:  python api/make_password_hash.py
AUTH_PASSWORD_HASH=

# Firma las cookies de sesión. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Cambiarlo cierra todas las sesiones abiertas.
SESSION_SECRET=
